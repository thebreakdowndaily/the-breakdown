# ============================================================
#  The Breakdown — Environment Configuration Template
#  Copy to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ---- Deployment ----
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ---- Google Search Console ----
# Get code from: https://search.google.com/search-console
# Use HTML tag verification method, paste the content value here
GOOGLE_SITE_VERIFICATION=your_verification_code_here

# ---- Supabase Database ----
# Required: set this to the explicitly chosen CMS database.
# Do not copy the canonical production or fact-check project URL unless its schema
# has been verified against the legacy CMS contract (stories.content + CMS workflow states).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ---- Session / Auth (for CMS admin panel) ----
SESSION_SECRET=

# ---- Newsroom publication approval ----
# Generate independent random secrets; do not copy a fixed example value.
# Pages admin API and Express backend must use different signing secrets.
PAGES_JWT_SECRET=
PAGES_ADMIN_PASSWORD=
# Dedicated Editor-in-Chief account; must differ from "admin".
PAGES_EDITOR_IN_CHIEF_USERNAME=
PAGES_EDITOR_IN_CHIEF_PASSWORD=
# The configured Editor-in-Chief username must also be in this allowlist.
PAGES_EDITOR_IN_CHIEF_USERNAMES=
JWT_SECRET=
ADMIN_PASSWORD=
# Exact public origin approved for releases, e.g. https://thebreakdown.in
PUBLICATION_DESTINATION=https://thebreakdown.in
# Comma-separated human Editor-in-Chief email addresses authorised to sign release approvals.
EDITOR_IN_CHIEF_EMAILS=

# ---- Monitoring ----
SENTRY_DSN=https://your_sentry_dsn_here

# ---- Local Development ----
PORT=3000
NODE_ENV=development

# ============================================================
#  Where to get each value:
#  CLOUDFLARE_API_TOKEN:   https://dash.cloudflare.com/profile/api-tokens
#  GOOGLE_SITE_VERIFICATION: https://search.google.com/search-console
#  SUPABASE values:        Supabase Dashboard > the explicitly selected CMS project > Project Settings > API
#  SENTRY_DSN:             https://sentry.io/settings/<org>/projects/the-breakdown/
# ============================================================
